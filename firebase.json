{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**",
      "**/private-data/**",
      "private-data/**",
      "supabase/**",
      "style-options/**",
      "**/*.xlsx",
      "**/*.xls",
      "**/*.zip",
      "**/*.tgz",
      "**/*.md",
      "**/firebase-debug.log"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
